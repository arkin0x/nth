  "private": false,
  "type": "module",
  "dependencies": {
    "axios": "^1.7.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "nikabrik": "^0.0.6",
    "pocketbase": "^0.21.3",
    "three": "^0.165.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.13.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "start": "concurrently \"npm:db*\" \"npm:build\" \"npm: run\"",
